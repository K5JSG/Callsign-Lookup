<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>CallsignLookup</RootNamespace>
    <AssemblyName>Callsign Lookup</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UI Automation (System.Windows.Automation), used to fill in HRD
         Logbook's log entry window - see Services/Hrd/HrdEditWindow.cs. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Jeremy S. Gaynor, K5JSG</Authors>
    <Company>K5JSG</Company>
    <Copyright>Copyright © 2026. Jeremy S. Gaynor, K5JSG. All Rights Reserved.</Copyright>
    <Description>Looks up a callsign on QRZ.com and works out the station's 6-character grid square, county, CQ zone, ITU zone, ARRL section and IOTA island from its location.</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
    <!-- Window icons and the logo shown in the main window - see AppLogo.cs.
         Logo.png (the full-size source artwork) is kept in the project folder
         to regenerate these from, not shipped. -->
    <EmbeddedResource Include="logo.ico" LogicalName="AppLogo/logo.ico" />
    <EmbeddedResource Include="logo-256.png" LogicalName="AppLogo/logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests/ holds the separate test project (see the .slnx) - without this,
         this project's default recursive file glob would also try to compile
         its source files into itself. -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF drops these two from the implicit usings (WPF has types of
         the same names); this app uses no WPF types, so put them back. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CallsignLookup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read-only lookup data, shipped in a Data\ folder next to the exe:
         counties.json, cqZones.json and ituZones.json (shared with POTA
         Activator Park Activations), arrlSections.json, ontarioDivisions.json,
         iota.json (the IOTA directory) and iotaIslands.json. -->
    <None Update="Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
